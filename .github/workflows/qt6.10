name: Build Qt6.10 Windows x64

on:
  workflow_dispatch:
  push:
    branches:
      - qt6

jobs:
  build-win64:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4
      with:
        submodules: recursive

    - name: Remove bundled qt.conf (source)
      shell: pwsh
      run: |
        $ErrorActionPreference = "Stop"
        Remove-Item -Force -ErrorAction SilentlyContinue "bundle\win\qt.conf"
        Remove-Item -Force -ErrorAction SilentlyContinue "bundle\win\.qt.conf"

    - name: Nuke MinGW and Path Contamination
      shell: pwsh
      run: |
        $path = $env:Path -split ';' | Where-Object { $_ -notmatch 'mingw' -and $_ -notmatch 'strawberry' }
        [Environment]::SetEnvironmentVariable("Path", ($path -join ';'), "Process")
        echo "Cleaned Path: $env:Path"

    - name: Prepare Libmpv (User Provided v3 URL)
      shell: pwsh
      run: |
        New-Item -ItemType Directory -Force -Path "dep-install/bin", "dep-install/lib", "dep-install/include"
        $url = "https://downloads.sourceforge.net/project/mpv-player-windows/libmpv/mpv-dev-x86_64-v3-20240922-git-71f2220.7z"
        Invoke-WebRequest -Uri $url -OutFile "mpv.7z" -UserAgent "curl/7.88.1" -MaximumRedirection 10
        7z x mpv.7z -ompv
        Set-Location mpv
        cmd.exe /c "call `"C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat`" && dumpbin /exports libmpv-2.dll > exports.txt"
        $defContent = @("LIBRARY libmpv-2.dll", "EXPORTS") + (Get-Content exports.txt | ForEach-Object { if ($_ -match "^\s+\d+\s+[0-9A-F]+\s+[0-9A-F]+\s+(\S+)") { $matches[1] } })
        $defContent | Set-Content libmpv-2.def
        cmd.exe /c "call `"C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat`" && lib /def:libmpv-2.def /out:libmpv.lib /MACHINE:X64"
        Copy-Item -Recurse -Force include\* ..\dep-install\include\
        Copy-Item libmpv.lib ..\dep-install\lib\
        Copy-Item libmpv-2.dll ..\dep-install\bin\

    - name: Install Qt 6.10.1
      uses: jurplel/install-qt-action@v4
      with:
        version: "6.10.1"
        target: "desktop"
        arch: "win64_msvc2022_64"
        modules: "qtwebengine qtwebchannel qtmultimedia qtpositioning qtshadertools qtimageformats qtserialport"

    - name: Setup Build Environment
      shell: cmd
      run: |
        call "C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat"
        if not exist dep-install\bin mkdir dep-install\bin
        if not exist dep-install\include mkdir dep-install\include
        if not exist dep-install\lib mkdir dep-install\lib
        curl -L https://github.com/ninja-build/ninja/releases/download/v1.10.2/ninja-win.zip -o ninja.zip
        tar -xf ninja.zip -C dep-install\bin
        del ninja.zip
        echo %GITHUB_WORKSPACE%\dep-install\bin>> %GITHUB_PATH%
        pip install reuse

    - name: Prepare SDL2
      shell: pwsh
      run: |
        Invoke-WebRequest -Uri "https://github.com/libsdl-org/SDL/releases/download/release-2.30.0/SDL2-devel-2.30.0-VC.zip" -OutFile "sdl2.zip"
        Expand-Archive "sdl2.zip" -DestinationPath "sdl2-temp" -Force
        $root = (Get-ChildItem "sdl2-temp" | Select-Object -First 1).FullName
        Copy-Item -Recurse -Force "$root\include\*" "dep-install\include\"
        Copy-Item -Force "$root\lib\x64\SDL2.lib" "dep-install\lib\"
        Copy-Item -Force "$root\lib\x64\SDL2main.lib" "dep-install\lib\"
        Copy-Item -Force "$root\lib\x64\SDL2.dll" "dep-install\bin\"

    - name: Prepare ECM and MpvQt
      shell: cmd
      run: |
        call "C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat"
        set "INSTALL_DIR=%GITHUB_WORKSPACE%\dep-install"
        set "INSTALL_DIR_FWD=%GITHUB_WORKSPACE:\=/%/dep-install"
        set "INCLUDE_DIR_FWD=%GITHUB_WORKSPACE:\=/%/dep-install/include"
        git clone https://github.com/KDE/extra-cmake-modules.git
        cd extra-cmake-modules
        cmake -B build -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="%INSTALL_DIR%"
        ninja -C build install
        cd ..
        git clone --branch v1.0.0 https://github.com/KDE/mpvqt.git
        cd mpvqt
        powershell -Command "$c = Get-Content src/mpvcontroller.h -Raw; $c = $c -replace '\s*virtual\s+~MpvController\(\).*?;', '' -replace '\s*~MpvController\(\).*?;', ''; $nl = [Environment]::NewLine; $c = $c.Replace('explicit MpvController(QObject *parent = nullptr);', 'explicit MpvController(QObject *parent = nullptr);' + $nl + '    virtual ~MpvController();'); Set-Content src/mpvcontroller.h $c"
        echo. >> src\mpvcontroller.cpp
        echo MpvController::~MpvController() = default; >> src\mpvcontroller.cpp
        cmake -B build -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="%INSTALL_DIR%" -DCMAKE_PREFIX_PATH="%INSTALL_DIR_FWD%;%Qt6_DIR%" -DECM_DIR="%INSTALL_DIR_FWD%/share/ECM/cmake" -DCMAKE_CXX_FLAGS="-I\"%INCLUDE_DIR_FWD%\""
        ninja -C build install
        cd ..

    - name: Download & Stage VC++ Redist and OpenSSL
      shell: pwsh
      run: |
        New-Item -ItemType Directory -Force -Path bundle/win
        Invoke-WebRequest -Uri "https://aka.ms/vs/17/release/vc_redist.x64.exe" -OutFile "bundle/win/vcredist_x64.exe"
        Invoke-WebRequest -Uri "https://download.firedaemon.com/FireDaemon-OpenSSL/openssl-3.6.0.zip" -OutFile "openssl.zip"
        Expand-Archive "openssl.zip" -DestinationPath "openssl-temp" -Force
        $binPath = (Get-ChildItem -Path "openssl-temp" -Recurse -Filter "libssl-3-x64.dll" | Select-Object -First 1).DirectoryName
        Copy-Item "$binPath\libssl-3-x64.dll" "dep-install\bin\"
        Copy-Item "$binPath\libcrypto-3-x64.dll" "dep-install\bin\"

    - name: Patch WiX Bundle.wxs
      shell: pwsh
      run: |
        $bundle  = "bundle/win/Bundle.wxs"
        if (Test-Path $bundle) {
          $c = Get-Content -Raw $bundle -Encoding UTF8
          $c = $c -replace 'Source=".*vcredist_x64.exe"', 'Source="bundle\win\vcredist_x64.exe"'
          $c = [regex]::Replace($c, 'C:\\Program Files \(x86\)\\Microsoft Visual Studio\\(2019|2022)\\BuildTools\\VC\\Redist\\MSVC\\[^"\\]+\\vcredist_x64\.exe', 'vcredist_x64.exe')
          Set-Content -LiteralPath $bundle -Value $c -Encoding UTF8
        }

    - name: Patch Source Code (Include Fix + GL Compat)
      shell: pwsh
      run: |
        # (unchanged; omitted here for brevity — keep your existing patch block)
        Write-Host "Source patched (includes + GL compat)."

    - name: Build Jellyfin Desktop
      shell: pwsh
      run: |
        $root = (Get-Location).Path.Replace("\", "/")
        $depInstall = "$root/dep-install"
        $libMpv = "$depInstall/lib/libmpv.lib"
        $incMpv = "$depInstall/include"
        $mpvQtDir = "$depInstall/lib/cmake/MpvQt"
        $installPrefix = "$root/output"

        $cmakeMod = "CMakeModules/FindMPV.cmake"
        $overrideContent = @(
          'set(MPV_FOUND TRUE)'
          "set(MPV_INCLUDE_DIR `"$incMpv`")"
          "set(MPV_LIBRARY `"$libMpv`")"
          "set(MPV_LIBRARIES `"$libMpv`")"
          "set(MPV_INCLUDE_DIRS `"$incMpv`")"
          'if(NOT TARGET MPV::MPV)'
          '  add_library(MPV::MPV UNKNOWN IMPORTED)'
          "  set_target_properties(MPV::MPV PROPERTIES IMPORTED_LOCATION `"$libMpv`" INTERFACE_INCLUDE_DIRECTORIES `"$incMpv`")"
          'endif()'
        ) -join "`r`n"
        Set-Content -Path $cmakeMod -Value $overrideContent -Encoding UTF8

        cmd.exe /c "call `"C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat`" && cmake -B build -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=`"$installPrefix`" -DCMAKE_PREFIX_PATH=`"$depInstall;$env:Qt6_DIR`" -DMpvQt_DIR=`"$mpvQtDir`" ."
        if ($LASTEXITCODE -ne 0) { exit 1 }

        Set-Location build
        cmd.exe /c "call `"C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat`" && ninja install"

    - name: Deploy Qt and Finalize
      shell: pwsh
      run: |
        $outDir = "$((Get-Location).Path)/output"
        $depInstall = "$((Get-Location).Path)/dep-install"
        if (-not (Test-Path $outDir)) { throw "Output directory missing!" }

        # Always use Qt from install-qt-action
        $qtBin = Join-Path $env:Qt6_DIR "bin"
        if (-not (Test-Path $qtBin)) { throw "Qt bin path not found: $qtBin" }

        Write-Host "Detected Qt Bin Path: $qtBin"
        $qtRoot = Split-Path $qtBin -Parent

        Write-Host "Forcing Qt DLL copy..."
        $qtDlls = @(
          "Qt6Core.dll","Qt6Gui.dll","Qt6Widgets.dll","Qt6Network.dll",
          "Qt6Quick.dll","Qt6Qml.dll","Qt6Svg.dll","Qt6OpenGL.dll",
          "Qt6QmlModels.dll","Qt6QmlWorkerScript.dll",
          "Qt6WebEngineCore.dll","Qt6WebEngineQuick.dll"
        )
        foreach ($q in $qtDlls) {
          $src = Join-Path $qtBin $q
          if (Test-Path $src) { Copy-Item -Force $src $outDir } else { Write-Warning "Could not find $src" }
        }

        Write-Host "Manually copying WebEngine Resources..."
        $resSrc = Join-Path $qtRoot "resources"
        if (Test-Path $resSrc) {
          New-Item -ItemType Directory -Force -Path (Join-Path $outDir "resources") | Out-Null
          Copy-Item -Force -Recurse (Join-Path $resSrc "*") (Join-Path $outDir "resources")
        }

        $processExe = Join-Path $qtBin "QtWebEngineProcess.exe"
        if (Test-Path $processExe) { Copy-Item -Force $processExe $outDir }

        Copy-Item -Force "$depInstall/bin/*.dll" $outDir

        $exePath = Join-Path $outDir "Jellyfin Desktop.exe"
        $qmlArgs = @()
        if (Test-Path "$depInstall/lib/qml") { $qmlArgs += "--qmlimport"; $qmlArgs += "$depInstall/lib/qml" }

        Write-Host "Running windeployqt..."
        & "windeployqt" --release --force --qmldir src/ui @qmlArgs --compiler-runtime --xml "$exePath"

        if (Test-Path "$outDir\qt.conf")  { Remove-Item -Force "$outDir\qt.conf" }
        if (Test-Path "$outDir\.qt.conf") { Remove-Item -Force "$outDir\.qt.conf" }

        $vcRoot = "C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Redist\MSVC"
        $runtimeDll = Get-ChildItem -Path $vcRoot -Recurse -Filter "vcruntime140.dll" | Where-Object { $_.FullName -match "x64" } | Select-Object -First 1
        if ($runtimeDll) {
          $redistDir = $runtimeDll.DirectoryName
          Copy-Item -Force "$redistDir\*.dll" $outDir
        }

        Write-Host "--- Content of Output Dir ---"
        Get-ChildItem $outDir | Select-Object Name

    - name: Create Portable Zip
      shell: pwsh
      run: Compress-Archive -Path output\* -DestinationPath Jellyfin-Desktop-Portable.zip

    - name: Upload Portable Zip
      uses: actions/upload-artifact@v4
      with:
        name: jellyfin-desktop-portable
        path: Jellyfin-Desktop-Portable.zip

    - name: Build Installer Package
      shell: cmd
      run: |
        call "C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat"
        set PATH=%PATH%;C:\Program Files (x86)\WiX Toolset v3.11\bin
        cd build
        ninja windows_package

    - name: Archive installer
      uses: actions/upload-artifact@v4
      with:
        name: jellyfin-desktop-windows
        path: build/JellyfinDesktop-*.exe
